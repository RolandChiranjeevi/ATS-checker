<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CV ATS Check – {{ report.source }}</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 48rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; color: #1a1a1a; }
  .badge { display: inline-block; min-width: 3.2rem; text-align: center; padding: 0 .4rem; border-radius: .3rem; font-weight: 600; color: #fff; }
  .PASS { background: #1a7f37; } .WARN { background: #9a6700; } .FAIL { background: #cf222e; }
  blockquote { margin: 1rem 0; padding: .5rem 1rem; border-left: 4px solid #999; background: #f6f6f6; }
  ul.summary { list-style: none; padding: 0; }
  ul.summary li { margin: .25rem 0; }
  section.check { margin: 1.5rem 0; }
  .extra { font-family: ui-monospace, monospace; font-size: .9rem; margin: .25rem 0; }
  .downloads a { display: inline-block; margin: 0 .5rem .5rem 0; padding: .4rem .9rem; border: 1px solid #555; border-radius: .3rem; color: inherit; text-decoration: none; font-weight: 600; }
  details.ats-view { margin: 1rem 0; }
  details.ats-view summary { cursor: pointer; font-weight: 600; }
  pre.ats-text { white-space: pre-wrap; word-break: break-word; background: #f6f6f6; padding: .75rem 1rem; border-radius: .3rem; font-size: .85rem; }
  .page-label { font-weight: 600; margin: 1rem 0 .25rem; }
  .INFO { background: #57606a; }
  table.facts { border-collapse: collapse; width: 100%; font-size: .9rem; margin: .5rem 0; }
  table.facts th, table.facts td { text-align: left; vertical-align: top; padding: .35rem .5rem; border-bottom: 1px solid #ddd; }
  table.facts td { word-break: break-word; }
  table.facts ul.links { margin: .35rem 0 0; padding-left: 1.1rem; }
  table.facts ul.links a { color: #0969da; }
</style>
</head>
<body>
{% if back_link %}<p><a href="{{ back_link }}">&larr; Check another CV</a></p>{% endif %}
<h1>CV ATS Check</h1>
<p><strong>File:</strong> {{ report.source }}</p>
{% if downloads %}<p class="downloads">{% for label, filename, href in downloads %}<a download="{{ filename }}" href="{{ href }}">{{ label }}</a>{% endfor %}</p>{% endif %}
<blockquote>{{ disclaimer_sv }}<br>{{ disclaimer_en }}</blockquote>

<h2>Summary</h2>
<ul class="summary">
{% for name, status, note in rows %}
  <li><span class="badge {{ status }}">{{ status }}</span> {{ name }}{% if note %} – {{ note }}{% endif %}</li>
{% endfor %}
</ul>
<p><strong>Totals:</strong> {{ counts["PASS"] }} PASS, {{ counts["WARN"] }} WARN, {{ counts["FAIL"] }} FAIL</p>

<h2>Details</h2>
<section class="check">
  <h3>Parser status</h3>
  <p><span class="badge PASS">PASS</span> {{ report.parser_message }}</p>
</section>
{% for r, extra in results %}
<section class="check">
  <h3>{{ r.name }}</h3>
  <p><span class="badge {{ r.status.value }}">{{ r.status.value }}</span> {{ r.message }}</p>
  {% if r.suggestion %}<p><strong>Suggestion:</strong> {{ r.suggestion }}</p>{% endif %}
  {% for line in extra %}<p class="extra">{{ line }}</p>{% endfor %}
  {% if r.facts %}
  <table class="facts">
    <thead><tr><th>Item</th><th>Value</th><th>Status</th><th>Note</th></tr></thead>
    <tbody>
    {% for f in r.facts %}
      {% set label = f.status.value if f.status else "INFO" %}
      <tr><td>{{ f.label }}</td><td>{{ f.value }}{% if f.links %}<ul class="links">{% for url in f.links %}<li><a href="{{ url }}" target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer">{{ url }}</a></li>{% endfor %}</ul>{% endif %}</td><td><span class="badge {{ label }}">{{ label }}</span></td><td>{{ f.note }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endfor %}

{% if report.extracted_pages %}
<h2>What an ATS sees</h2>
<p>This is the text extracted from your file, in the order a parser reads it. If your name,
dates or section headings look jumbled, missing or out of order here, an ATS will see the same.</p>
<details class="ats-view">
  <summary>Show extracted text</summary>
  {% for page, text in report.extracted_pages %}
  {% if report.paginated %}<p class="page-label">Page {{ page }}</p>{% endif %}
  <pre class="ats-text">{{ text }}</pre>
  {% endfor %}
</details>
{% endif %}

<h2>Disclaimer</h2>
<p>{{ disclaimer_sv }}</p>
<p>{{ disclaimer_en }}</p>
<p><em>{{ privacy_note }}</em></p>
</body>
</html>
